REQUESTED_VERSION=2.1.296
DEPENDENCY_ROOT=/var/lib/dependency/ClaudeCode-Enterprise-Pure
INSTALL_BASE=http://agent-platform-scaffold.oss-cn-shanghai-internal.aliyuncs.com/claude-code

detect_platform() {
    if [ "$(uname -s 2>/dev/null || true)" != "Linux" ]; then
        harbor_log "unsupported operating system: $(uname -s 2>/dev/null || echo unknown)"
        return 1
    fi

    if [ -f /etc/alpine-release ] || ldd --version 2>&1 | grep -qi musl; then
        HARBOR_LIBC="musl"
    else
        HARBOR_LIBC="glibc"
    fi

    case "$(uname -m 2>/dev/null || true):$HARBOR_LIBC" in
        x86_64:glibc|amd64:glibc) PLATFORM="linux-x64" ;;
        x86_64:musl|amd64:musl) PLATFORM="linux-x64-musl" ;;
        aarch64:musl|arm64:musl) PLATFORM="linux-arm64-musl" ;;
        aarch64:glibc|arm64:glibc)
            harbor_log "unsupported platform: ARM64 requires the linux-arm64-musl artifact"
            return 1 ;;
        *)
            harbor_log "unsupported platform: arch=$(uname -m 2>/dev/null || echo unknown) libc=$HARBOR_LIBC"
            return 1 ;;
    esac
    harbor_log "platform=$PLATFORM libc=$HARBOR_LIBC"
}

checksum_for() {
    local sums="$1" relative="$2"
    [ -r "$sums" ] || { harbor_log "checksum manifest missing: $sums"; return 1; }
    awk -v relative="$relative" '
        length($1) == 64 && $1 ~ /^[[:xdigit:]]+$/ {
            name = $2
            sub(/^\*/, "", name)
            if (name == relative || name ~ ("/" relative "$")) {
                print $1
                exit
            }
        }
    ' "$sums"
}

verify_checksum() {
    local binary="$1" sums="$2" relative="$3" expected actual
    expected="$(checksum_for "$sums" "$relative")" || return 1
    [ -n "$expected" ] || { harbor_log "checksum entry missing for $relative"; return 1; }
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "$binary" | awk '{print $1}')"
    elif command -v shasum >/dev/null 2>&1; then
        actual="$(shasum -a 256 "$binary" | awk '{print $1}')"
    else
        harbor_log "no SHA-256 utility available"
        return 1
    fi
    [ "$actual" = "$expected" ] || {
        harbor_log "checksum mismatch for $relative"
        return 1
    }
}

install_binary() {
    local source="$1" target_dir target
    target_dir="$HOME/.local/lib/claude-code-enterprise/$REQUESTED_VERSION/$PLATFORM"
    target="$target_dir/claude-enterprise"
    mkdir -p "$target_dir" "$HOME/.local/bin"
    cp "$source" "$target"
    chmod 0755 "$target"
    # The claude alias lets the inherited ClaudeCode.run() invoke this binary.
    ln -sfn "$target" "$HOME/.local/bin/claude-enterprise"
    ln -sfn "$target" "$HOME/.local/bin/claude"
}

verify_installed() {
    local version_output
    version_output="$(claude-enterprise --version 2>&1)" || {
        harbor_log "claude-enterprise --version failed"
        return 1
    }
    printf '%s\n' "$version_output" | grep -F -- "$REQUESTED_VERSION" >/dev/null || {
        harbor_log "installed version does not match $REQUESTED_VERSION: $version_output"
        return 1
    }
}

install_from_dependency() {
    local relative source sums
    relative="$REQUESTED_VERSION/$PLATFORM/claude"
    source="$DEPENDENCY_ROOT/$relative"
    sums="$DEPENDENCY_ROOT/SHA256SUMS.txt"
    [ -f "$source" ] || { harbor_log "dependency binary missing: $source"; return 1; }
    verify_checksum "$source" "$sums" "$relative" || return 1
    install_binary "$source" && verify_installed
}

install_from_oss() {
    # Mirror ClaudeCode's native leg: fetch the official claude-code
    # install.sh and run it with CLAUDE_PREFER_ENTERPRISE=1 so it
    # installs the enterprise build of $REQUESTED_VERSION from the
    # sibling .../claude-code-enterprise prefix, falling back to the
    # official binary when that version/platform isn't mirrored there.
    local script rc=1
    command -v curl >/dev/null 2>&1 || { harbor_log "curl is unavailable for OSS fallback"; return 1; }
    script="$(mktemp /tmp/claude-enterprise-install.XXXXXX)" || return 1
    if harbor_run_capped 30 curl -fsSL --retry 2 --connect-timeout 10 --max-time 30                     "$INSTALL_BASE/install.sh" -o "$script"                     && CLAUDE_INSTALL_BASE_URL="$INSTALL_BASE" CLAUDE_PREFER_ENTERPRISE=1                         harbor_run_capped 120 bash "$script" ${REQUESTED_VERSION:+"$REQUESTED_VERSION"}; then
        # install.sh installs `claude`; expose it as claude-enterprise
        # too so the inherited version/verify commands keep working.
        ln -sfn "$HOME/.local/bin/claude" "$HOME/.local/bin/claude-enterprise" 2>/dev/null || true
        verify_installed && rc=0
    fi
    rm -f "$script"
    return "$rc"
}

detect_platform || {
    harbor_log "HARBOR_INSTALL_RESULT=failure source=unsupported-platform"
    exit 1
}
harbor_try dependency-image install_from_dependency                 || harbor_try oss-mirror install_from_oss                 || {
        harbor_log "HARBOR_INSTALL_RESULT=failure source=all-legs-exhausted version=$REQUESTED_VERSION platform=$PLATFORM"
        exit 1
    }
harbor_log "HARBOR_INSTALL_RESULT=success source=${HARBOR_INSTALL_SOURCE:-unknown} version=$REQUESTED_VERSION platform=$PLATFORM elapsed=$((SECONDS - HARBOR_T0))s"

